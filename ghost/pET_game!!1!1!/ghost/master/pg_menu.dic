 OnCookMenu : all
{
				OnViewAbove
  "\![*]\q[add vegtables to pot,OnVeggies]\n"
  "\![*]\q[Beans & Lentils,OnBeans]\n"
  "\![*]\q[add Meat to pot,OnMeat]\n"
					--
  if ARRAYSIZE(pot) >= 5;"\n\![*]\q[continue,ToCook]"//Add a check for if the pot is just full of water for spaghetti :3
					--
  if ARRAYSIZE(pot) >= 1;"\n\n\![*]\q[Remove all,RESETCOOKING]"
					--
  "\n\n[half]\![*]\q[Close menu,CANCEL]\n"					
					--
  "\n\n[half]\![*]\q[STOP,QUITCOOK]\n\e"
}


  OnVeggies : all
{OnViewAbove
"\c\_q"
    "\![*]\q[carrots,carrot]\n"
    "\![*]\q[celery,celery]\n"
    "\![*]\q[Peas,pea]\n"
    "\![*]\q[Potato,potato]\n"
				--
  "\n\n[half]\![*]\q[back,OnCookMenu]\e"
}

  OnBeans : all
{OnViewAbove
	"\c\_q"
    "\![*]\q[chickpeas,garbonzo]\n"
    "\![*]\q[Green lentils,green]\n"
    "\![*]\q[Red lentils,red]\n"
				--
  "\n\n[half]\![*]\q[back,OnCookMenu]\e"
}

  OnMeat : all
{OnViewAbove
	"\c\_q"
    "\![*]\q[Beef,beef]\n"
    "\![*]\q[Chicken,chikn]\n"
				--
  "\n\n[half]\![*]\q[back,OnCookMenu]\e"
}


 TempatureMenu : all
{
  "\![*]\q[Off,BurnerOff]\n"
  "low\n \![*]\q[1,BurnerOn1] \![*]\q[2,BurnerOn2] \![*]\q[3,BurnerOn3]\n"
  "medium\n \![*]\q[4,BurnerOn4] \![*]\q[5,BurnerOn5] \![*]\q[6,BurnerOn6]\n"
  "high\n \![*]\q[7,BurnerOn7] \![*]\q[8,BurnerOn8] \![*]\q[9,BurnerOn9]\n\n[half]"
  "\![*]\q[back,OnPotMenu] \n\![*]\q[Close menu,CANCEL]\e"
}