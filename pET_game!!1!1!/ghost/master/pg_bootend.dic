//\![raise,OnFirstBoot,0]

 OnFirstBoot : all
{
  lastTalk 	     = ""
  talktime 	     = "5 minutes"


  
  bakingstage	 = "DOUGH"
  cookingstage	 = "EMPTY"
  
  autos 		 = "OFF"
  StirCountDown	 = "OFF"
  StirTimer 	 = "OFF"

  Tempature      = "OFF"
  timetoboil	 = "OFF"
  pot 		     = IARRAY

  nowshell 	     = "master"
  oven			 = "closed"
  view		     = "ground"  
  mini		     = 0  
  
  hungr			 = 0
  full			 = 10  
  
  cookhour		 = 0
  cooking 		 = 0
  cookmin		 = 0
  cooksec		 = 0

  passhour	     = 0
  passmin		 = 0 
  passsec 	     = 0

  stroke         = 0
  aitalkinterval = 300

  
  if reference0 == 0
  {
	OnSetBreadPosition
	OnViewGround
    "\0\s[0]Helloo!\w4 Thank you for checking this little thing out, picture bare-bones, yeah thats this thing.\w8\n\w8See the readme for a longer thing, its practically just a preview tbh T vT\w4\e"
  }
}


 OnBoot
{
  lastTalk = ""
  mini	   = 0
  passhour = 0
  passmin  = 0
  passsec  = 0
  
  if bakingstage == ""; OnSetBreadPosition
  OnViewGround
  --
  "%(normalboottalk)"
  
}

 OnSetBreadPosition
{
	_brebpos = ("floor","counter"); breadpos = ANY(_brebpos)
}

 normalboottalk
{
	"Welcome back.\e"
}

 OnClose
{ 
  "Thank you for stopping by ^^\w8\w8\-" 
}
