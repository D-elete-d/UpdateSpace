
/*------------------ OTHER ------------------*/

Select.RESETCOOKING{"\0\s[1]\i[600]"; pot = IARRAY; cookbegins = 0; OnCookMenu}

Select.CANCEL{OnViewAbove/*"( ´･･)ﾉ(._.`))"*/}

Select.QUITCOOK{OnViewGround;"\0\s[0]"; pot = IARRAY; cooking = 0}

/*------------------ COOOKING SELECT! ------------------*/


/*--------- Beans & Lentils ---------*/

Select.garbonzo : all
{
    _search = ASEARCH("Chickpeas",pot)
    if _search != -1
    {
        pot[_search] = IARRAY
		"\![anim,stop,2604]"
		--
		OnBeans
    }
	else{ 
	pot ,= "Chickpeas"
	"\i[2604]"
	--
	OnBeans}
}

Select.Speghetti : all
{
    _search = ASEARCH("Speghetti",pot)
    if _search != -1
    {
        pot[_search] = IARRAY
		"\![anim,stop,2000]"
		--
		OnBeans
    }
	else{ 
	pot ,= ""
	"\i[2000]"
	--
	OnBeans}
}

