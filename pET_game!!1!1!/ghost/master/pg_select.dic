/*---------- TEMPATURE SELECT ----------*/


Select.BurnerOff
{
	Tempature  = "OFF"
	StirTimer  = "OFF"
	timetoboil = "OFF"
}

Select.BurnerOn1
{
	Tempature  = 1
	StirTimer  = 2100 //every 35 minutes
	
	if timetoboil == "OFF"; timetoboil = 7200//2 hours
	elseif timetoboil == "boiling" || timetoboil == "boiled"{/*(_　_)。゜watched pots never boil..。*/}
}

Select.BurnerOn2
{
	Tempature  = 2
	StirTimer  = 1800 //every 30 minutes
	
	if timetoboil == "OFF"; timetoboil = 5400//1h 30m
   elseif timetoboil == "boiling" || timetoboil == "boiled"{}
}	

Select.BurnerOn3
{
	Tempature  = 3
	StirTimer  = 1500 //every 25 mins
	
	if timetoboil == "OFF"; timetoboil = 4800//1h 20m
   elseif timetoboil == "boiling" || timetoboil == "boiled"{}
}	

Select.BurnerOn4
{
	Tempature  = 4
	StirTimer  = 1200 //every 20 minutes
	
	if timetoboil == "OFF"; timetoboil = 3600//1h
   elseif timetoboil == "boiling" || timetoboil == "boiled"{}
}	

